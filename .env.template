# ============================================
# TRANSACTION CATEGORIZER SERVICE
# ============================================

# Service Configuration
SERVICE_NAME=transaction-categorizer
SERVICE_PORT=8009
ENVIRONMENT=development
RELOAD=true

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/categorizer_db

# Kafka Configuration (if using)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions.categorize

# RabbitMQ Configuration (if using)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Logging
LOG_LEVEL=INFO
LOG_JSON_ENABLED=false

# ML Model Settings
MODEL_PATH=./models/categorizer.pkl
CONFIDENCE_THRESHOLD=0.7

# Development Settings
DEV_MODE=true

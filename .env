# API Settings
API_VERSION=v1
API_PORT=8001
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./categorizer.db

# Kafka (optional - service works without it)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=raw-transactions
KAFKA_CATEGORIZED_TOPIC=categorized-transactions

# Categorizer Settings
DEFAULT_CATEGORY=Other
CONFIDENCE_THRESHOLD=0.7
ENABLE_ML=false

# CORS - Use JSON array format
CORS_ORIGINS=["http://localhost:3000","http://localhost:8003"]

# Logging
LOG_LEVEL=INFO
